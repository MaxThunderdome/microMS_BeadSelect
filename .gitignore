# Track only what is needed to run the tool; everything else in this
# folder (scans, results, saves, docs, tests) stays local.
*
!.gitignore
!microMS_beadtargeting.py
!requirements.txt
!microms/
!microms/**
__pycache__/
*.py[cod]

# FilterTrainer/ is its own git repository (see FilterTrainer/.gitignore)
FilterTrainer/
# filters/ holds trained filters (FilterTrainer .json); optional, local only
filters/
